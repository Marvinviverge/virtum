# Lab d'exemple : un serveur web et une base, sur un réseau isolé.
#   virtum plan -f examples/Virtumfile    # ce qui va être créé, sans rien toucher
#   virtum up -f examples/Virtumfile      # puis http://127.0.0.1:18098
#   virtum down -f examples/Virtumfile --destroy
name: demo-lab

# Champs optionnels du lab :
# subnet: 10.42.0.0/24     # réseau du lab (sinon calculé depuis le nom ; voir virtum plan)
# bind: lan                # exposer les ports: sur le réseau local (confirmation demandée)
# restart: unless-stopped  # démarrage au boot de l'hôte : no | always | unless-stopped

machines:
  web:
    os: debian-12
    ram: 2048
    cpu: 2
    disk_size: 20G
    ports:
      - "18098:80"         # 127.0.0.1:18098 de l'hôte → port 80 de la VM
    provision:
      - apt-get update
      - apt-get install -y nginx

  db:
    os: ubuntu-24.04
    ram: 1024
    cpu: 1
    # ip: 10.42.0.20       # adresse fixe (avec subnet: ci-dessus)
